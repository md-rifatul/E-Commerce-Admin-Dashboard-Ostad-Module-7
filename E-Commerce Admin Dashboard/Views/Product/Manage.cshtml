@using E_Commerce_Admin_Dashboard.ViewModels
@model ManagePageViewModel

<h2>Manage Products</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h3>All Products</h3>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Stock</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Products.Items)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Description</td>
                <td>@product.Price</td>
                <td>@product.StockQuantity</td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= Model.Products.TotalPages; i++)
        {
            <li class="page-item @(i == Model.Products.CurrentPage ? "active" : "")">
                <a class="page-link"
                   asp-action="Manage"
                   asp-route-page="@i">
                    @i
                </a>
            </li>
        }
    </ul>
</nav>


<hr />

<h3>Add New Product</h3>

<form asp-controller="Product" asp-action="AddProduct" method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="NewProduct.Name" class="form-label"></label>
        <input asp-for="NewProduct.Name" class="form-control" />
        <span asp-validation-for="NewProduct.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NewProduct.Description" class="form-label"></label>
        <input asp-for="NewProduct.Description" class="form-control" />
        <span asp-validation-for="NewProduct.Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NewProduct.Price" class="form-label"></label>
        <input asp-for="NewProduct.Price" class="form-control" />
        <span asp-validation-for="NewProduct.Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NewProduct.StockQuantity" class="form-label"></label>
        <input asp-for="NewProduct.StockQuantity" class="form-control" />
        <span asp-validation-for="NewProduct.StockQuantity" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Add Product</button>
</form>

<br />

<a asp-controller="Product" asp-action="Dashboard" class="btn btn-primary">Back to Dashboard</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}